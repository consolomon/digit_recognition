# Committed on every branch (owner, 2026-10-17) — holds no secrets; never
# put one here. docker compose reads it from the project directory
# automatically. Change values on dev, never on the VPS checkout.

# Local stack (master / dev): host port for the web server.
WEB_HOST_PORT=8008

# Production (deploy branch, VPS): nginx server_name / certificate path and
# the certbot registration email — resources/documentation/DEPLOY_INIT.md.
DOMAIN=sandbox.prosvet.io
CERTBOT_EMAIL=consolomon1998@gmail.com
